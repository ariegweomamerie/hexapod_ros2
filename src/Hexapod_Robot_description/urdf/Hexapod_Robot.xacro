<?xml version="1.0" ?>
<robot name="Hexapod_Robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find Hexapod_Robot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find Hexapod_Robot_description)/urdf/Hexapod_Robot.ros2control" />
<xacro:include filename="$(find Hexapod_Robot_description)/urdf/Hexapod_Robot.gazebo" />

<!-- Massless root frame at ground level. KDL cannot have inertia on the root
     link, and controllers/nav expect a base_footprint; base_link carries the
     real mass and hangs off this. -->
<link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="base_link"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="0.11456741037796862 0.1087879851109223 0.05265501684792295" rpy="0 0 0"/>
    <mass value="11.924165027690854"/>
    <inertia ixx="0.104112" iyy="0.070049" izz="0.13759" ixy="-7e-06" iyz="-0.000382" ixz="-0.000256"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Hexapod_Robot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Hexapod_Robot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

