<!-- ==========================================================================
     Foot-tip frames (one per leg), computed from the femur mesh geometry as
     the vertex furthest from each femur joint (~0.179 m leg segment). These are
     the IK target frames and foot-contact references for the gait.
     ========================================================================== -->
<xacro:macro name="foot_frame" params="leg parent x y z">
  <link name="${leg}_foot">
    <!-- rounded rubber foot pad: a stable, high-friction ground contact
         (replaces the sharp mesh-tip point contact that caused slip) -->
    <collision name="${leg}_foot_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.013"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="${leg}_foot_joint" type="fixed">
    <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    <parent link="${parent}"/>
    <child link="${leg}_foot"/>
  </joint>
  <!-- keep the foot link separate (don't lump into the femur) so its collision
       keeps the name the contact sensor references -->
  <gazebo reference="${leg}_foot_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  <!-- high-grip foot pad + contact sensor (foot-ground touch detection) -->
  <gazebo reference="${leg}_foot">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
    <sensor name="${leg}_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <!-- gz's URDF->SDF conversion appends "_collision" to the URDF collision
             name, so the actual SDF collision is "<name>_collision_collision" -->
        <collision>${leg}_foot_collision_collision</collision>
      </contact>
      <topic>contact/${leg}</topic>
    </sensor>
  </gazebo>
</xacro:macro>

<xacro:foot_frame leg="leg_l1" parent="femur_lift_leg1_link_1"  x="0.0532"  y="0.0113" z="-0.1702"/>
<xacro:foot_frame leg="leg_l2" parent="femur_lift_leg2_link_1"  x="0.0403"  y="0.0368" z="-0.1702"/>
