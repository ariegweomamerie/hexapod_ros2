<?xml version="1.0" ?>
<robot name="Hexapod_Robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==========================================================================
       ros2_control description for the hexapod.

       Hardware is the Gazebo Sim (gz) system plugin, so the SAME controllers
       drive the simulated joints and (later) real servos - only the <plugin>
       swaps out for a hardware driver.

       Joint naming (chain position -> hexapod convention):
         *_coxa  = joint on base_link  (yaw / swing)         [was Revolute 1,2,3,11,12,15]
         *_femur = middle joint        (lift)                [was Revolute 5,6,7,13,14,16]
         *_tibia = outer joint         (knee)                [was Revolute 8,9,10,17,18,19]
       initial_value = spawn/stance pose (radians). FIRST GUESS - tune visually.
       ========================================================================== -->

  <!-- params named lower/upper (NOT min/max) to avoid shadowing xacro's
       built-in min()/max() functions. -->
  <xacro:macro name="hex_joint" params="name lower upper init">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${init}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="HexapodGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ===== Left legs (l1, l2, l3) =====
         init = STAND pose: mirror-symmetric radial footprint (front/rear legs
         splayed 35 deg, middle straight out), feet 150 mm from each hip, body
         143 mm high. Coxa joints are re-zeroed in the URDF, so every coxa is 0.
         Femur/tibia differ slightly per leg because the CAD joint zeros differ
         (the leg SHAPES are symmetric). Keep in sync with STAND_Q in gait_node.py. -->
    <xacro:hex_joint name="leg_l1_coxa"  lower="-0.523599" upper="0.523599" init="0.0"/>
    <xacro:hex_joint name="leg_l1_femur" lower="-1.570796" upper="0.0"      init="-0.5920"/>
    <xacro:hex_joint name="leg_l1_tibia" lower="-0.349066" upper="0.698132" init="0.2684"/>

    <xacro:hex_joint name="leg_l2_coxa"  lower="-0.523599" upper="0.523599" init="0.0"/>
    <xacro:hex_joint name="leg_l2_femur" lower="-1.570796" upper="0.0"      init="-0.5921"/>
    <xacro:hex_joint name="leg_l2_tibia" lower="-0.349066" upper="0.698132" init="0.2687"/>

    <xacro:hex_joint name="leg_l3_coxa"  lower="-0.523599" upper="0.523599" init="0.0"/>
    <xacro:hex_joint name="leg_l3_femur" lower="-1.570796" upper="0.0"      init="-0.4538"/>
    <xacro:hex_joint name="leg_l3_tibia" lower="-0.349066" upper="0.698132" init="0.2681"/>

    <!-- ===== Right legs (r1, r2, r3) - mirrored limits/stance ===== -->
    <xacro:hex_joint name="leg_r1_coxa"  lower="-0.523599" upper="0.523599" init="0.0"/>
    <xacro:hex_joint name="leg_r1_femur" lower="0.0"       upper="1.570796" init="0.5557"/>
    <xacro:hex_joint name="leg_r1_tibia" lower="-0.698132" upper="0.349066" init="-0.4075"/>

    <xacro:hex_joint name="leg_r2_coxa"  lower="-0.523599" upper="0.523599" init="0.0"/>
    <xacro:hex_joint name="leg_r2_femur" lower="0.0"       upper="1.570796" init="0.5557"/>
    <xacro:hex_joint name="leg_r2_tibia" lower="-0.698132" upper="0.349066" init="-0.4075"/>

    <xacro:hex_joint name="leg_r3_coxa"  lower="-0.523599" upper="0.523599" init="0.0"/>
    <xacro:hex_joint name="leg_r3_femur" lower="0.0"       upper="1.570796" init="0.5556"/>
    <xacro:hex_joint name="leg_r3_tibia" lower="-0.698132" upper="0.349066" init="-0.4088"/>

    <!-- ===== Pan/tilt face ===== -->
    <!-- Joints are re-zeroed in the URDF: init 0.0 = face looks straight and level.
         Limits match the URDF (pan left +, tilt up +). -->
    <xacro:hex_joint name="face_pan"  lower="-0.378190" upper="0.319942" init="0.0"/>
    <xacro:hex_joint name="face_tilt" lower="-0.423252" upper="0.623945" init="0.0"/>

  </ros2_control>

</robot>
