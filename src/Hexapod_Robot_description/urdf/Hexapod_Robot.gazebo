<gazebo reference="face_bracet_base_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<!-- RGB-D camera on the head, for visual SLAM. Depth is rendered geometry, not
     something derived from the colour image. Colour and depth are two separate
     sensors sharing one mounting link, one set of optics and one 15 Hz rate,
     and both stamp their data with face_camera_optical_frame, the REP-145
     optical frame. The ROS-facing interface is:
       /face_camera/image        colour, 640x480 rgb8
       /face_camera/depth_image  depth, 640x480 32FC1 metres, 0.10-12 m
       /face_camera/camera_info  intrinsics, from the colour sensor alone
       /face_camera/points       organised cloud, xyz + greyscale intensity
     Two sensors rather than one rgbd_camera because the combined sensor's depth
     and colour failed together under the rendering defect in
     docs/KNOWN_ISSUES.md; split, colour is unaffected. 15 Hz is plenty for RGB-D
     SLAM and leaves rendering budget; 87 deg matches the class of depth camera
     this robot would carry. -->
<gazebo reference="face_camera_link">
  <!-- The colour sensor also owns /face_camera/camera_info: Gazebo derives a
       sensor's camera_info topic from its image topic, and these are the
       intrinsics both streams share. -->
  <sensor name="face_camera_rgb" type="camera">
    <always_on>1</always_on>
    <update_rate>15</update_rate>
    <topic>face_camera/image</topic>
    <gz_frame_id>face_camera_optical_frame</gz_frame_id>
    <camera>
      <horizontal_fov>1.518</horizontal_fov>
      <image><width>640</width><height>480</height><format>R8G8B8</format></image>
      <clip><near>0.10</near><far>12.0</far></clip>
      <optical_frame_id>face_camera_optical_frame</optical_frame_id>
    </camera>
  </sensor>
  <sensor name="face_camera_depth" type="depth_camera">
    <always_on>1</always_on>
    <update_rate>15</update_rate>
    <!-- Its own Gazebo namespace on purpose. Gazebo derives a sensor's
         camera_info topic from its image topic by replacing the last component,
         so a depth topic of face_camera/depth_image would resolve to
         face_camera/camera_info and publish the intrinsics a second time on top
         of the colour sensor's. (camera_info_topic does not help: the plain
         camera honours it, DepthCameraSensor does not.) Under this namespace
         the depth sensor owns /face_camera_depth/camera_info instead, and the
         ros_gz bridge maps its image and cloud back onto the unchanged ROS
         names /face_camera/depth_image and /face_camera/points. -->
    <topic>face_camera_depth/image</topic>
    <gz_frame_id>face_camera_optical_frame</gz_frame_id>
    <camera>
      <horizontal_fov>1.518</horizontal_fov>
      <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
      <clip><near>0.10</near><far>12.0</far></clip>
      <optical_frame_id>face_camera_optical_frame</optical_frame_id>
    </camera>
  </sensor>
</gazebo>

<!-- gz_ros2_control: runs a controller_manager inside Gazebo and exposes the
     joints declared in Hexapod_Robot.ros2control. Controllers are configured
     from config/controllers.yaml. -->
<gazebo>
  <plugin filename="gz_ros2_control-system"
          name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(find Hexapod_Robot_description)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>

<!-- IMU system: drives the <sensor type="imu"> on base_link (the BNO055). -->
<gazebo>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
</gazebo>

<!-- Contact system: drives the per-foot <sensor type="contact"> (foot-ground touch). -->
<gazebo>
  <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
</gazebo>

<!-- Sensors system: renders camera sensors (the face camera). Needs OpenGL. -->
<gazebo>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
</gazebo>

<!-- Ground-truth odometry, for EVALUATION ONLY. It is perfect (it comes from the
     simulator's own pose), so it must never become the robot's odometry source:
     it would hide exactly the drift visual odometry is supposed to be judged on.
     The TF it publishes is deliberately NOT bridged into /tf - odom -> base_footprint
     belongs to visual odometry from Stage 2.3 on. ROS sees it as /odom_ground_truth. -->
<gazebo>
  <plugin filename="gz-sim-odometry-publisher-system"
          name="gz::sim::systems::OdometryPublisher">
    <odom_frame>odom_ground_truth</odom_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
    <odom_publish_frequency>50</odom_publish_frequency>
    <dimensions>3</dimensions>
    <tf_topic>/model/Hexapod_Robot/odom_tf</tf_topic>
  </plugin>
</gazebo>

</robot>
