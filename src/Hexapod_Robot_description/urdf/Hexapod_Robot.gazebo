</gazebo>

<gazebo reference="femur_lift_leg2_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="femur_lift_leg1_link_1">
  <material>${body_color}</material>
