<?xml version="1.0" ?>
<robot name="Hexapod_Robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
  <!-- IMU on the body (simulates the real Adafruit BNO055): orientation +
       angular velocity + linear acceleration. Published on gz topic "imu". -->
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <topic>imu</topic>
    <gz_frame_id>base_link</gz_frame_id>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

<gazebo reference="left_hip_swing_forward_back1_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

