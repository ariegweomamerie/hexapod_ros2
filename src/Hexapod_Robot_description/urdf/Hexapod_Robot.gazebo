<?xml version="1.0" ?>
<robot name="Hexapod_Robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
  <!-- IMU on the body (simulates the real Adafruit BNO055): orientation +
       angular velocity + linear acceleration. Published on gz topic "imu". -->
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <topic>imu</topic>
    <gz_frame_id>base_link</gz_frame_id>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

<gazebo reference="left_hip_swing_forward_back1_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_hip_swing_forward_back2_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_hip_swing_forward_back3_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_tibia_knee1_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_tibia_knee2_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_tibia_knee3_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="femur_lift_leg3_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="femur_lift_leg2_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="femur_lift_leg1_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_hip_swing_forward_back1_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_hip_swing_forward_back2_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_tibia_knee1_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_tibia_knee2_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_hip_swing_forward_back3_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_tibia_knee3_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="femur_right_leg1_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="femur_right_leg2_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="femur_right_leg3_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="face_bracet_base_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="face_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
  <!-- Camera mounted on the face (simulates the Pi camera). Rigidly aligned with
       the face's front surface: optical axis = face front normal, image-up = face
       up, placed 12 mm in front of the screen centre. So the camera always looks
       exactly where the face looks; with face_pan = face_tilt = 0 that is straight
       ahead and level. Publishes /face_camera/image and /face_camera/camera_info. -->
  <sensor name="face_camera" type="camera">
    <pose>0.032470 -0.042942 0.035805 -0.000309 -0.362146 -1.599897</pose>
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <topic>face_camera/image</topic>
    <gz_frame_id>face_link_1</gz_frame_id>
    <camera>
      <horizontal_fov>1.0472</horizontal_fov>
      <image><width>640</width><height>480</height><format>R8G8B8</format></image>
      <clip><near>0.05</near><far>15.0</far></clip>
    </camera>
  </sensor>
</gazebo>

<!-- gz_ros2_control: runs a controller_manager inside Gazebo and exposes the
     joints declared in Hexapod_Robot.ros2control. Controllers are configured
     from config/controllers.yaml. -->
<gazebo>
  <plugin filename="gz_ros2_control-system"
          name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(find Hexapod_Robot_description)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>

<!-- IMU system: drives the <sensor type="imu"> on base_link (the BNO055). -->
<gazebo>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
</gazebo>

<!-- Contact system: drives the per-foot <sensor type="contact"> (foot-ground touch). -->
<gazebo>
  <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
</gazebo>

<!-- Sensors system: renders camera sensors (the face camera). Needs OpenGL. -->
<gazebo>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
</gazebo>

<!-- Odometry: publishes odom->base_footprint so RViz (fixed frame "odom") shows
     the robot travel, not just step in place. TF is bridged to ROS /tf. -->
<gazebo>
  <plugin filename="gz-sim-odometry-publisher-system"
          name="gz::sim::systems::OdometryPublisher">
    <odom_frame>odom</odom_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
    <odom_publish_frequency>50</odom_publish_frequency>
    <dimensions>3</dimensions>
    <tf_topic>/model/Hexapod_Robot/odom_tf</tf_topic>
  </plugin>
</gazebo>

</robot>
