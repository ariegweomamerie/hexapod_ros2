</gazebo>

<gazebo reference="face_bracet_base_link_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<!-- RGB-D camera on the head, for visual SLAM. Gazebo's native rgbd_camera
     renders colour AND depth from the same optics, so depth is real geometry,
     not something derived from the colour image. One sensor publishes:
       face_camera/image        colour
       face_camera/depth_image  depth, 32-bit float metres
       face_camera/points       organised point cloud
       face_camera/camera_info  intrinsics shared by both streams
     It is mounted on face_camera_link (pose comes from the URDF joint) and its
     data is stamped with face_camera_optical_frame, the REP-145 optical frame.
     15 Hz is plenty for RGB-D SLAM and leaves rendering budget; 87 deg matches
     the class of depth camera this robot would carry. -->
<gazebo reference="face_camera_link">
  <sensor name="face_camera" type="rgbd_camera">
    <always_on>1</always_on>
    <update_rate>15</update_rate>
    <topic>face_camera</topic>
    <gz_frame_id>face_camera_optical_frame</gz_frame_id>
    <camera>
      <horizontal_fov>1.518</horizontal_fov>
      <image><width>640</width><height>480</height><format>R8G8B8</format></image>
      <clip><near>0.10</near><far>12.0</far></clip>
      <depth_camera><clip><near>0.10</near><far>12.0</far></clip></depth_camera>
      <optical_frame_id>face_camera_optical_frame</optical_frame_id>
    </camera>
  </sensor>
</gazebo>

<!-- gz_ros2_control: runs a controller_manager inside Gazebo and exposes the
     joints declared in Hexapod_Robot.ros2control. Controllers are configured
     from config/controllers.yaml. -->
<gazebo>
  <plugin filename="gz_ros2_control-system"
          name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(find Hexapod_Robot_description)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>

<!-- IMU system: drives the <sensor type="imu"> on base_link (the BNO055). -->
<gazebo>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
</gazebo>

<!-- Contact system: drives the per-foot <sensor type="contact"> (foot-ground touch). -->
<gazebo>
  <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
</gazebo>

<!-- Sensors system: renders camera sensors (the face camera). Needs OpenGL. -->
<gazebo>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
</gazebo>

<!-- Ground-truth odometry, for EVALUATION ONLY. It is perfect (it comes from the
     simulator's own pose), so it must never become the robot's odometry source:
     it would hide exactly the drift visual odometry is supposed to be judged on.
     The TF it publishes is deliberately NOT bridged into /tf - odom -> base_footprint
     belongs to visual odometry from Stage 2.3 on. ROS sees it as /odom_ground_truth. -->
<gazebo>
  <plugin filename="gz-sim-odometry-publisher-system"
          name="gz::sim::systems::OdometryPublisher">
    <odom_frame>odom_ground_truth</odom_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
    <odom_publish_frequency>50</odom_publish_frequency>
    <dimensions>3</dimensions>
    <tf_topic>/model/Hexapod_Robot/odom_tf</tf_topic>
  </plugin>
</gazebo>

</robot>
